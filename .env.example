# Copie para .env e preencha. O .env nunca vai para o Git.

# TMDB: themoviedb.org → Configurações → API.
# Pode ser a "Chave da API" (v3) ou o "Token de leitura da API" (v4).
TMDB_TOKEN=

DATABASE_URL=postgresql://filmes:filmes@localhost:5433/filmes
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Gemini: aistudio.google.com → chave de API (a camada gratuita basta).
GEMINI_API_KEY=
# Ordem de tentativa; se um modelo estiver sobrecarregado, usa o próximo.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-4-hydrogen

# Modelo de embeddings (Hugging Face). Se trocar, ajuste a dimensão.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
